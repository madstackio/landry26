---
import type { Globals, Page, PageSummary, Special } from "../lib/cms";
import type { Anchor } from "../lib/anchors";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SpecialsModal from "../components/SpecialsModal.astro";
import "../styles/global.css";

interface Props {
  globals: Globals;
  pages: PageSummary[];
  page?: Page | null;
  specials?: Special[];
  /** Active extra locale (e.g. "es"), or null for the default locale. */
  locale?: string | null;
  /** Current path WITHOUT any locale prefix, e.g. "/" or "/amenities". */
  path?: string;
  /** In-page anchors for one-page navigation. */
  anchors?: Anchor[];
}

const {
  globals,
  pages,
  page = null,
  specials = [],
  locale = null,
  path = "/",
  anchors = [],
} = Astro.props;

const siteName = globals.name || "The Landry";
const meta = page?.meta ?? null;
const title = meta?.title || (page ? `${page.title} · ${siteName}` : siteName);
const description = meta?.description || null;
// keywords may arrive as a string or an array of strings
const keywords = Array.isArray(meta?.keywords)
  ? (meta?.keywords as string[]).join(", ")
  : meta?.keywords || null;
const canonical = meta?.canonical_url ?? new URL(path, Astro.site).href;
const ogImage = meta?.og_image_url ?? null;
const favicon = globals.favicon_url ?? "/assets/logo.svg";

// hreflang alternates between locale variants of this page
const site = Astro.site ?? new URL("https://landryliving.com");
const defaultUrl = new URL(path, site).href;
const alternates =
  globals.locales?.length
    ? [
        { hreflang: globals.default_locale || "en", href: defaultUrl },
        ...globals.locales.map((l) => ({
          hreflang: l,
          href: new URL(`/${l}${path === "/" ? "" : path}`, site).href,
        })),
        { hreflang: "x-default", href: defaultUrl },
      ]
    : [];

const tracking = globals.tracking ?? {};
const gtagId = tracking.ga4_measurement_id || tracking.google_ads_id || null;
const jsonLdItems = [...(globals.json_ld ?? []), ...(page?.json_ld ?? [])];
const htmlLang = locale ?? globals.default_locale ?? "en";
// Pages that open with a hero get the transparent overlay header.
const heroFirst = /hero/.test(page?.sections?.[0]?.type ?? "");
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {keywords && <meta name="keywords" content={keywords} />}
    {meta?.noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />

    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Marcellus&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
    />
    <script is:inline src="https://unpkg.com/lucide@0.454.0/dist/umd/lucide.min.js"></script>

    {/* Site-wide + page JSON-LD, emitted verbatim from the CMS */}
    {
      jsonLdItems.map((item) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
      ))
    }

    {/* Analytics — IDs managed in LucidOS, injected only when present */}
    {
      tracking.gtm_container_id && (
        <script
          is:inline
          set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${tracking.gtm_container_id}');`}
        />
      )
    }
    {
      gtagId && (
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gtagId}`} />
      )
    }
    {
      gtagId && (
        <script
          is:inline
          set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());${
            tracking.ga4_measurement_id ? `gtag('config','${tracking.ga4_measurement_id}');` : ""
          }${tracking.google_ads_id ? `gtag('config','${tracking.google_ads_id}');` : ""}`}
        />
      )
    }
    {
      tracking.meta_pixel_id && (
        <script
          is:inline
          set:html={`!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','${tracking.meta_pixel_id}');fbq('track','PageView');`}
        />
      )
    }

    {globals.custom_head_tags && <Fragment set:html={globals.custom_head_tags} />}

    {/* LucidOS live-preview bridge (see LUCIDOS.md) */}
    <script
      is:inline
      set:html={`(function(){var ADMIN='https://lucid.madstack.io';var t=new URLSearchParams(location.search).get('lucid_preview');if(t){document.cookie='lucid_preview='+encodeURIComponent(t)+'; path=/; SameSite=None; Secure';}if(window.self===window.top)return;if(!t&&!/(?:^|; )lucid_preview=/.test(document.cookie))return;try{window.parent.postMessage({source:'lucid',v:1,type:'bridge:ready',payload:{href:location.href,path:location.pathname,capabilities:['reload','highlight']}},ADMIN);}catch(e){}window.addEventListener('message',function(e){if(e.origin!==ADMIN)return;var m=e.data||{};if(m.type==='admin:content-updated'){location.reload();}else if(m.type==='admin:highlight'&&m.payload&&m.payload.instanceId){var el=document.querySelector('[data-lucid-section="'+m.payload.instanceId+'"]');if(el){el.scrollIntoView({behavior:'smooth',block:'center'});el.style.outline='2px solid #2A6E99';el.style.outlineOffset='4px';setTimeout(function(){el.style.outline='';el.style.outlineOffset='';},2000);}}});})();`}
    />
  </head>
  <body>
    {
      tracking.gtm_container_id && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${tracking.gtm_container_id}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
          />
        </noscript>
      )
    }
    {
      tracking.meta_pixel_id && (
        <noscript>
          <img
            height="1"
            width="1"
            style="display:none"
            src={`https://www.facebook.com/tr?id=${tracking.meta_pixel_id}&ev=PageView&noscript=1`}
            alt=""
          />
        </noscript>
      )
    }

    <SiteHeader
      globals={globals}
      pages={pages}
      locale={locale}
      anchors={anchors}
      transparent={heroFirst}
    />
    <main>
      <slot />
    </main>
    <SiteFooter globals={globals} pages={pages} locale={locale} anchors={anchors} />
    <SpecialsModal specials={specials} />

    <script is:inline set:html={`window.lucide&&window.lucide.createIcons();`}></script>
    {/* LucidOS AI leasing chat — renders only when enabled for the org */}
    <script is:inline src="https://lucid.madstack.io/widget/chat/v1.js" data-site="the-landry" async
    ></script>
  </body>
</html>
