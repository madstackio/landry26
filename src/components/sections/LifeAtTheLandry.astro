---
import type { Section } from "../../lib/cms";

interface Props {
  section: Section;
}

// Custom `life-at-the-landry` type: sticky intro column + numbered amenity
// list. The CMS data carries no icon field, so icons are inferred from the
// amenity title (Lucide names), falling back to a generic check.
const { data } = Astro.props.section;
const amenities: { icon?: string; title: string; description?: string }[] = Array.isArray(
  data.amenities
)
  ? data.amenities
  : [];
const buttons: { button_title?: string; button_url?: string }[] = Array.isArray(data.button)
  ? data.button
  : [];
const button = buttons[0];
const buttonHref = button?.button_url && button.button_url !== "#" ? button.button_url : "#gallery";

const ICON_RULES: [RegExp, string][] = [
  [/pool|swim/i, "waves"],
  [/fitness|gym|active/i, "dumbbell"],
  [/kitchen|clubhouse|lounge/i, "cooking-pot"],
  [/dog|pet/i, "dog"],
  [/playground|play/i, "trees"],
  [/picnic|grill|bbq/i, "flame"],
  [/gate|secure|access/i, "shield-check"],
  [/laundry|wash/i, "shirt"],
  [/park/i, "car"],
];

function iconFor(a: { icon?: string; title: string }) {
  if (a.icon) return a.icon;
  for (const [pattern, icon] of ICON_RULES) {
    if (pattern.test(a.title)) return icon;
  }
  return "check";
}
---

<section class="life">
  <div class="container cols">
    <div class="intro">
      {data.featured_image && <img class="photo" src={data.featured_image} alt="" loading="lazy" />}
      {data.byline && <div class="eyebrow byline">{data.byline}</div>}
      {data.heading && <h2 set:html={data.heading} />}
      {data.content && <div class="richtext content" set:html={data.content} />}
      {
        button?.button_title && (
          <a href={buttonHref} class="btn btn--secondary">
            {button.button_title}
          </a>
        )
      }
    </div>
    <div class="list">
      {
        amenities.map((a, i) => (
          <div class="row">
            <div class="num">{String(i + 1).padStart(2, "0")}</div>
            <div>
              <div class="title">{a.title}</div>
              {a.description && <div class="desc">{a.description}</div>}
            </div>
            <div class="icon">
              <i data-lucide={iconFor(a)} style="width:24px;height:24px" />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .life {
    padding: 112px 0;
  }

  .cols {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 80px;
    align-items: start;
  }

  .intro {
    position: sticky;
    top: 110px;
  }

  .photo {
    width: 100%;
    height: 230px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }

  .byline {
    margin-top: 28px;
  }

  h2 {
    font-size: 44px;
    margin: 16px 0 20px;
    text-wrap: pretty;
  }

  .content {
    font-size: 17px;
    line-height: 1.65;
    color: var(--text-muted);
    margin: 0 0 28px;
    max-width: 380px;
  }

  .row {
    display: grid;
    grid-template-columns: 56px 1fr 40px;
    gap: 20px;
    align-items: center;
    padding: 26px 8px;
    border-top: 1px solid var(--border-subtle);
    transition: background var(--dur-fast) ease;
  }

  .row:first-child {
    border-top-color: var(--border-strong);
  }

  .row:last-child {
    border-bottom: 1px solid var(--border-strong);
  }

  .row:hover {
    background: var(--white);
  }

  .num {
    font-family: var(--font-display);
    font-size: 19px;
    color: var(--slate-400);
  }

  .title {
    font-family: var(--font-display);
    font-size: 25px;
    color: var(--navy-900);
  }

  .desc {
    font-size: 15px;
    color: var(--text-muted);
    margin-top: 4px;
  }

  .icon {
    color: var(--navy-300);
  }

  @media (max-width: 920px) {
    .cols {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .intro {
      position: static;
    }
  }
</style>
