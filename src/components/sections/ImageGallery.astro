---
import type { Section } from "../../lib/cms";

interface Props {
  section: Section;
}

const { data } = Astro.props.section;
// Gallery items may be objects ({ image, caption }) or bare URL strings.
const images: { image: string; caption?: string }[] = (Array.isArray(data.images)
  ? data.images
  : []
)
  .map((item: any) => (typeof item === "string" ? { image: item } : item))
  .filter((item: any) => item && item.image);
---

<section class="gallery">
  <div class="container head">
    <div>
      <div class="eyebrow">Gallery</div>
      {data.heading ? <h2 set:html={data.heading} /> : <h2>Take a look around.</h2>}
    </div>
    <p class="note">Every photo is the real thing — warm Texas light included.</p>
  </div>
  <div class="container">
    <div class="masonry">
      {
        images.map((img) => (
          <figure>
            <img src={img.image} alt={img.caption || ""} loading="lazy" />
            {img.caption && <figcaption>{img.caption}</figcaption>}
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .gallery {
    padding: 104px 0;
  }

  .head {
    padding-bottom: 48px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  h2 {
    font-size: 44px;
    margin: 14px 0 0;
  }

  .note {
    font-size: 16px;
    color: var(--text-muted);
    max-width: 340px;
    margin: 0;
    text-align: right;
  }

  /* Masonry via CSS columns — items keep their natural aspect ratios */
  .masonry {
    columns: 4 260px;
    column-gap: 10px;
  }

  figure {
    margin: 0 0 10px;
    overflow: hidden;
    position: relative;
    border-radius: var(--radius-md);
    break-inside: avoid;
  }

  img {
    width: 100%;
    display: block;
    transition: transform 300ms ease;
  }

  figure:hover img {
    transform: scale(1.045);
  }

  figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 24px 16px 12px;
    font-size: 13px;
    color: var(--cream-50);
    background: linear-gradient(180deg, transparent, rgba(11, 44, 64, 0.7));
    opacity: 0;
    transition: opacity 200ms ease;
  }

  figure:hover figcaption {
    opacity: 1;
  }

  @media (max-width: 640px) {
    .masonry {
      columns: 2 140px;
      column-gap: 6px;
    }

    figure {
      margin-bottom: 6px;
    }
  }
</style>
