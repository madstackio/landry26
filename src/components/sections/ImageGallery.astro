---
import type { Section } from "../../lib/cms";

interface Props {
  section: Section;
}

const { data } = Astro.props.section;
const MAX_PHOTOS = 15;
// Gallery items may be objects ({ image, caption }) or bare URL strings.
const images: { image: string; caption?: string }[] = (Array.isArray(data.images)
  ? data.images
  : []
)
  .map((item: any) => (typeof item === "string" ? { image: item } : item))
  .filter((item: any) => item && item.image)
  .slice(0, MAX_PHOTOS);

/*
 * Mosaic with explicit tile placement — no auto-flow, so no holes ever.
 * Repeating 5-image blocks each fill a 4-column × 2-row rectangle exactly;
 * leftover images (< 5) fill single rows, with the final tile stretched to
 * close out its row. The result is always one even rectangle.
 */
interface Tile {
  col: number;
  row: number;
  w: number;
  h: number;
}
const BLOCKS: { dc: number; dr: number; w: number; h: number }[][] = [
  // big square left, four singles right
  [
    { dc: 0, dr: 0, w: 2, h: 2 },
    { dc: 2, dr: 0, w: 1, h: 1 },
    { dc: 3, dr: 0, w: 1, h: 1 },
    { dc: 2, dr: 1, w: 1, h: 1 },
    { dc: 3, dr: 1, w: 1, h: 1 },
  ],
  // tall left, stacked wides, singles right
  [
    { dc: 0, dr: 0, w: 1, h: 2 },
    { dc: 1, dr: 0, w: 2, h: 1 },
    { dc: 3, dr: 0, w: 1, h: 1 },
    { dc: 1, dr: 1, w: 2, h: 1 },
    { dc: 3, dr: 1, w: 1, h: 1 },
  ],
  // four singles left, big square right
  [
    { dc: 0, dr: 0, w: 1, h: 1 },
    { dc: 1, dr: 0, w: 1, h: 1 },
    { dc: 2, dr: 0, w: 2, h: 2 },
    { dc: 0, dr: 1, w: 1, h: 1 },
    { dc: 1, dr: 1, w: 1, h: 1 },
  ],
];

const tiles: Tile[] = [];
let placed = 0;
let row = 1;
let block = 0;
while (images.length - placed >= 5) {
  for (const t of BLOCKS[block % BLOCKS.length]!) {
    tiles.push({ col: t.dc + 1, row: row + t.dr, w: t.w, h: t.h });
  }
  placed += 5;
  row += 2;
  block++;
}
const leftover = images.length - placed;
for (let k = 0; k < leftover; k++) {
  const isLast = k === leftover - 1;
  tiles.push({
    col: (k % 4) + 1,
    row: row + Math.floor(k / 4),
    w: isLast ? 4 - (k % 4) : 1,
    h: 1,
  });
}

// On mobile everything reflows to a 2-column auto grid; an odd count gets a
// double-width lead tile so the rectangle stays even there too.
const oddCount = images.length % 2 === 1;
---

<section class="gallery">
  <div class="container head">
    <div>
      <div class="eyebrow">Gallery</div>
      {data.heading ? <h2 set:html={data.heading} /> : <h2>Take a look around.</h2>}
    </div>
    <p class="note">Every photo is the real thing — warm Texas light included.</p>
  </div>
  <div class="container">
    <div class="mosaic">
      {
        images.map((img, i) => {
          const t = tiles[i]!;
          return (
            <figure
              class:list={{ lead: oddCount && i === 0 }}
              style={`--c:${t.col};--r:${t.row};--w:${t.w};--h:${t.h}`}
            >
              <img src={img.image} alt={img.caption || ""} loading="lazy" />
              {img.caption && <figcaption>{img.caption}</figcaption>}
            </figure>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .gallery {
    padding: 104px 0;
  }

  .head {
    padding-bottom: 48px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  h2 {
    font-size: 44px;
    margin: 14px 0 0;
  }

  .note {
    font-size: 16px;
    color: var(--text-muted);
    max-width: 340px;
    margin: 0;
    text-align: right;
  }

  .mosaic {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 190px;
    gap: 10px;
  }

  figure {
    margin: 0;
    overflow: hidden;
    position: relative;
    border-radius: var(--radius-md);
    grid-column: var(--c) / span var(--w);
    grid-row: var(--r) / span var(--h);
  }

  img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    background: var(--navy-100);
    transition: transform 300ms ease;
  }

  figure:hover img {
    transform: scale(1.045);
  }

  figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 24px 16px 12px;
    font-size: 13px;
    color: var(--cream-50);
    background: linear-gradient(180deg, transparent, rgba(11, 44, 64, 0.7));
    opacity: 0;
    transition: opacity 200ms ease;
  }

  figure:hover figcaption {
    opacity: 1;
  }

  @media (max-width: 1000px) {
    .mosaic {
      grid-auto-rows: 150px;
    }
  }

  @media (max-width: 640px) {
    .mosaic {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 140px;
      gap: 6px;
    }

    figure {
      grid-column: auto / span 1;
      grid-row: auto / span 1;
    }

    figure.lead {
      grid-column: span 2;
    }
  }
</style>
