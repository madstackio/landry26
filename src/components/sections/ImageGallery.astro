---
import type { Section } from "../../lib/cms";

interface Props {
  section: Section;
}

const { data } = Astro.props.section;
// Gallery items may be objects ({ image, caption }) or bare URL strings.
const MAX_PHOTOS = 15;
const images: { image: string; caption?: string }[] = (Array.isArray(data.images)
  ? data.images
  : []
)
  .map((item: any) => (typeof item === "string" ? { image: item } : item))
  .filter((item: any) => item && item.image)
  .slice(0, MAX_PHOTOS);

// Mosaic masonry: mixed tile sizes on a 4-column grid, dense-packed into one
// even rectangle. The repeating span pattern is nudged so the total cell
// count divides evenly by the column count — no ragged bottom row.
const spans = images.map((_, i) => {
  if (i % 8 === 0) return { w: 2, h: 2 };
  if (i % 8 === 3) return { w: 1, h: 2 };
  if (i % 8 === 5) return { w: 2, h: 1 };
  return { w: 1, h: 1 };
});
let cells = spans.reduce((sum, s) => sum + s.w * s.h, 0);
for (let i = spans.length - 1; i >= 0 && cells % 4 !== 0; i--) {
  const s = spans[i]!;
  if (s.w === 1 && s.h === 1) {
    s.w = 2;
    cells += 1;
  }
}
---

<section class="gallery">
  <div class="container head">
    <div>
      <div class="eyebrow">Gallery</div>
      {data.heading ? <h2 set:html={data.heading} /> : <h2>Take a look around.</h2>}
    </div>
    <p class="note">Every photo is the real thing — warm Texas light included.</p>
  </div>
  <div class="container">
    <div class="mosaic">
      {
        images.map((img, i) => (
          <figure class:list={{ w2: spans[i]!.w === 2, h2: spans[i]!.h === 2 }}>
            <img src={img.image} alt={img.caption || ""} loading="lazy" />
            {img.caption && <figcaption>{img.caption}</figcaption>}
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .gallery {
    padding: 104px 0;
  }

  .head {
    padding-bottom: 48px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  h2 {
    font-size: 44px;
    margin: 14px 0 0;
  }

  .note {
    font-size: 16px;
    color: var(--text-muted);
    max-width: 340px;
    margin: 0;
    text-align: right;
  }

  .mosaic {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 190px;
    grid-auto-flow: dense;
    gap: 10px;
  }

  figure {
    margin: 0;
    overflow: hidden;
    position: relative;
    border-radius: var(--radius-md);
  }

  figure.w2 {
    grid-column: span 2;
  }

  figure.h2 {
    grid-row: span 2;
  }

  img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    background: var(--navy-100);
    transition: transform 300ms ease;
  }

  figure:hover img {
    transform: scale(1.045);
  }

  figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 24px 16px 12px;
    font-size: 13px;
    color: var(--cream-50);
    background: linear-gradient(180deg, transparent, rgba(11, 44, 64, 0.7));
    opacity: 0;
    transition: opacity 200ms ease;
  }

  figure:hover figcaption {
    opacity: 1;
  }

  @media (max-width: 1000px) {
    .mosaic {
      grid-auto-rows: 150px;
    }
  }

  @media (max-width: 640px) {
    .mosaic {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 130px;
      gap: 6px;
    }
  }
</style>
