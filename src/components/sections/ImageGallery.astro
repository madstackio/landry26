---
import type { Section } from "../../lib/cms";

interface Props {
  section: Section;
}

const { data } = Astro.props.section;
// Gallery items may be objects ({ image, caption }) or bare URL strings.
const images: { image: string; caption?: string }[] = (Array.isArray(data.images)
  ? data.images
  : []
)
  .map((item: any) => (typeof item === "string" ? { image: item } : item))
  .filter((item: any) => item && item.image);

// ~4 tiles visible at a time (the template's layout); the full set scrolls
// through continuously off-canvas. The track is duplicated for a seamless loop.
const marquee = images.length > 4;
const duration = Math.max(30, images.length * 5);
---

<section class="gallery">
  <div class="container head">
    <div>
      <div class="eyebrow">Gallery</div>
      {data.heading ? <h2 set:html={data.heading} /> : <h2>Take a look around.</h2>}
    </div>
    <p class="note">Every photo is the real thing — warm Texas light included.</p>
  </div>
  {
    marquee ? (
      <div class="marquee">
        <div class="track" style={`animation-duration:${duration}s`}>
          {[0, 1].map((copy) => (
            <div class="set" aria-hidden={copy === 1 ? "true" : undefined}>
              {images.map((img) => (
                <figure>
                  <img src={img.image} alt={img.caption || ""} loading="lazy" />
                  {img.caption && <figcaption>{img.caption}</figcaption>}
                </figure>
              ))}
            </div>
          ))}
        </div>
      </div>
    ) : (
      <div class="grid" style={`grid-template-columns:repeat(${Math.max(images.length, 1)},1fr)`}>
        {images.map((img) => (
          <figure>
            <img src={img.image} alt={img.caption || ""} loading="lazy" />
            {img.caption && <figcaption>{img.caption}</figcaption>}
          </figure>
        ))}
      </div>
    )
  }
</section>

<style>
  .gallery {
    padding: 104px 0 0;
    overflow: hidden;
  }

  .head {
    padding-bottom: 48px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  h2 {
    font-size: 44px;
    margin: 14px 0 0;
  }

  .note {
    font-size: 16px;
    color: var(--text-muted);
    max-width: 340px;
    margin: 0;
    text-align: right;
  }

  /* Static strip for 4 or fewer images */
  .grid {
    display: grid;
    gap: 6px;
    height: 420px;
  }

  /* Continuous marquee for larger sets */
  .marquee {
    width: 100%;
    overflow: hidden;
  }

  .track {
    display: flex;
    width: max-content;
    animation: gallery-marquee linear infinite;
  }

  .marquee:hover .track {
    animation-play-state: paused;
  }

  .set {
    display: flex;
    gap: 6px;
    padding-right: 6px;
  }

  .set figure {
    flex: 0 0 calc((100vw - 18px) / 4);
    height: 420px;
  }

  @keyframes gallery-marquee {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
  }

  figure {
    margin: 0;
    overflow: hidden;
    position: relative;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  figure:hover img {
    transform: scale(1.045);
  }

  figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 24px 16px 12px;
    font-size: 13px;
    color: var(--cream-50);
    background: linear-gradient(180deg, transparent, rgba(11, 44, 64, 0.7));
    opacity: 0;
    transition: opacity 200ms ease;
  }

  figure:hover figcaption {
    opacity: 1;
  }

  @media (max-width: 860px) {
    .set figure {
      flex-basis: calc((100vw - 6px) / 2);
      height: 300px;
    }

    .grid {
      grid-template-columns: 1fr 1fr !important;
      height: auto;
    }

    .grid figure {
      aspect-ratio: 4 / 3;
    }
  }
</style>
