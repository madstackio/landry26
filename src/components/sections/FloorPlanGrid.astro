---
import type { FloorPlan, Section } from "../../lib/cms";

interface Props {
  section: Section;
  locale?: string | null;
}

const { section, locale = null } = Astro.props;
const { data } = section;
const plans: FloorPlan[] = Array.isArray(data.items) ? data.items : [];
const count: number = typeof data.count === "number" ? data.count : plans.length;

const fmtLocale = locale || "en-US";
const money = new Intl.NumberFormat(fmtLocale, {
  style: "currency",
  currency: "USD",
  maximumFractionDigits: 0,
});
const dateFmt = new Intl.DateTimeFormat(fmtLocale, { month: "short", day: "numeric" });

const BED_LABELS: Record<number, string> = {
  0: "Studio",
  1: "One Bedroom",
  2: "Two Bedroom",
  3: "Three Bedroom",
  4: "Four Bedroom",
};

function bedLabel(beds: number) {
  return BED_LABELS[beds] ?? `${beds} Bedroom`;
}

function sqft(plan: FloorPlan) {
  if (!plan.sqft_min) return null;
  return plan.sqft_max && plan.sqft_max !== plan.sqft_min
    ? `${plan.sqft_min}–${plan.sqft_max} sq ft`
    : `${plan.sqft_min} sq ft`;
}

function availabilityLine(plan: FloorPlan) {
  if (!plan.available_count) return "None open right now — call for the latest availability";
  const homes = plan.available_count === 1 ? "1 home" : `${plan.available_count} homes`;
  if (!plan.available_from || plan.available_from === "now") return `${homes} available now`;
  try {
    return `${homes} available from ${dateFmt.format(new Date(plan.available_from + "T12:00:00"))}`;
  } catch {
    return `${homes} available`;
  }
}

/** Compact availability for the table row, e.g. "8 available now" / "2 from Aug 14". */
function availabilityShort(plan: FloorPlan) {
  if (!plan.available_count) return null;
  if (!plan.available_from || plan.available_from === "now")
    return `${plan.available_count} available now`;
  try {
    return `${plan.available_count} from ${dateFmt.format(new Date(plan.available_from + "T12:00:00"))}`;
  } catch {
    return `${plan.available_count} available`;
  }
}

const bedOptions = [...new Set(plans.map((p) => p.bedrooms))].sort((a, b) => a - b);
const showFilters = bedOptions.length > 1;
---

<section class="plans">
  <div class="container">
    <div class="head">
      <div>
        <div class="eyebrow">Residences</div>
        {data.heading ? <h2 set:html={data.heading} /> : <h2>Find the one that fits.</h2>}
        {data.intro && <div class="richtext intro" set:html={data.intro} />}
      </div>
      {
        showFilters && (
          <div class="filters" data-plan-filters>
            <button class="chip is-selected" data-beds="all">
              All Plans
            </button>
            {bedOptions.map((b) => (
              <button class="chip" data-beds={String(b)}>
                {bedLabel(b)}
              </button>
            ))}
          </div>
        )
      }
    </div>
    {
      plans.length > 0 ? (
        <div class="table" data-plan-table>
          {plans.map((p) => {
            const photo = p.photos?.[0];
            return (
              <div
                class="row"
                data-beds={String(p.bedrooms)}
                data-plan={p.slug}
                tabindex="0"
                role="button"
                aria-label={`View details for ${p.name}`}
              >
                {photo ? (
                  <div
                    class="thumb"
                    role="img"
                    aria-label={photo.alt || p.name}
                    style={`background-image:url('${photo.url}')`}
                  />
                ) : (
                  <div class="thumb" />
                )}
                <div>
                  <div class="name">{p.name}</div>
                  <div class="eyebrow type">{bedLabel(p.bedrooms)}</div>
                </div>
                <div class="meta">
                  {p.bedrooms === 0 ? "Studio" : `${p.bedrooms} bed`} · {p.bathrooms} bath
                </div>
                <div class="sqft">{sqft(p)}</div>
                <div class="price">
                  {p.starting_rent ? (
                    <span>
                      From {money.format(p.starting_rent)}
                      <span class="permo">/mo</span>
                    </span>
                  ) : (
                    <span class="permo">Call for pricing</span>
                  )}
                  {availabilityShort(p) ? (
                    <span class="avail-badge">{availabilityShort(p)}</span>
                  ) : (
                    <span class="waitlist">Ask about availability</span>
                  )}
                </div>
                <div class="actions">
                  <a href="#schedule-a-tour" class="btn btn--sm btn--secondary">
                    Tour This Plan
                  </a>
                  <span class="chev">
                    <i data-lucide="chevron-right" style="width:20px;height:20px" />
                  </span>
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        <p class="empty">
          Floor plan details are being updated — call the leasing office and we'll walk you through
          what's available.
        </p>
      )
    }
    {count > plans.length && <p class="note">Showing {plans.length} of {count} floor plans.</p>}
    <p class="note">
      Pricing reflects today's availability and can change daily. Your leasing team will confirm
      exact homes and move-in dates on your tour.
    </p>
  </div>

  {/* Detail modals — one per plan, populated from the same live CMS data */}
  {
    plans.map((p) => {
      const photos = p.photos ?? [];
      return (
        <div
          class="plan-modal"
          data-plan-modal={p.slug}
          role="dialog"
          aria-modal="true"
          aria-label={`${p.name} details`}
          hidden
        >
          <div class="modal-card">
            <button class="modal-close" data-modal-close aria-label="Close">
              <i data-lucide="x" style="width:20px;height:20px" />
            </button>
            <div class="modal-cols" class:list={{ "no-photos": photos.length === 0 }}>
              {photos.length > 0 && (
                <div class="gallery">
                  <img
                    class="main-photo"
                    src={photos[0]!.url}
                    alt={photos[0]!.alt || p.name}
                    data-main-photo
                  />
                  {photos.length > 1 && (
                    <div class="thumbs">
                      {photos.map((ph, i) => (
                        <button
                          class:list={["thumb-btn", { "is-current": i === 0 }]}
                          data-photo={ph.url}
                          aria-label={`Photo ${i + 1}`}
                        >
                          <img src={ph.url} alt="" loading="lazy" />
                        </button>
                      ))}
                    </div>
                  )}
                </div>
              )}
              <div class="details">
                <div class="eyebrow">{bedLabel(p.bedrooms)}</div>
                <h3>{p.name}</h3>
                <div class="spec-line">
                  {p.bedrooms === 0 ? "Studio" : `${p.bedrooms} bed`} · {p.bathrooms} bath
                  {sqft(p) ? ` · ${sqft(p)}` : ""}
                </div>
                <div class="modal-price">
                  {p.starting_rent ? (
                    <>
                      From {money.format(p.starting_rent)}
                      <span class="permo">/mo</span>
                    </>
                  ) : (
                    "Call for pricing"
                  )}
                </div>
                <div class="avail" class:list={{ waitlisted: !p.available_count }}>
                  {availabilityLine(p)}
                </div>
                {p.description && <p class="desc">{p.description}</p>}
                {(p.features?.length ?? 0) > 0 && (
                  <ul class="features">
                    {p.features!.map((f) => (
                      <li>
                        <i data-lucide="check" style="width:16px;height:16px" />
                        {f}
                      </li>
                    ))}
                  </ul>
                )}
                <a href="#schedule-a-tour" class="btn btn--lg modal-cta" data-modal-close>
                  Tour This Plan
                </a>
              </div>
            </div>
          </div>
        </div>
      );
    })
  }
</section>

<style>
  .plans {
    background: var(--cream-100);
    padding: 104px 0;
  }

  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  h2 {
    font-size: 44px;
    margin: 14px 0 0;
  }

  .intro {
    font-size: 16px;
    color: var(--text-muted);
    max-width: 480px;
    margin-top: 12px;
  }

  .filters {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .table {
    background: var(--white);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: 8px 32px;
  }

  .row {
    display: grid;
    grid-template-columns: 110px 1.5fr 1fr 0.9fr 1.1fr auto;
    gap: 24px;
    align-items: center;
    padding: 22px 0;
    border-top: 1px solid var(--border-subtle);
    cursor: pointer;
  }

  .row:hover .name {
    color: var(--navy-500);
  }

  .row:hover .chev {
    transform: translateX(3px);
    color: var(--navy-500);
  }

  .row:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
    border-radius: var(--radius-md);
  }

  .row:first-child {
    border-top: none;
  }

  .row[hidden] {
    display: none;
  }

  .thumb {
    width: 110px;
    height: 76px;
    border-radius: var(--radius-md);
    background-color: var(--navy-100);
    background-size: cover;
    background-position: center;
  }

  .name {
    font-family: var(--font-display);
    font-size: 25px;
    color: var(--navy-900);
    transition: color var(--dur-fast) ease;
  }

  .type {
    font-size: 12px;
    margin-top: 3px;
  }

  .meta {
    font-size: 15px;
    color: var(--slate-600);
  }

  .sqft {
    font-size: 15px;
    color: var(--charcoal-700);
  }

  .price {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    font-weight: var(--weight-bold);
    color: var(--navy-700);
    font-size: 19px;
  }

  .permo {
    font-weight: var(--weight-regular);
    color: var(--slate-600);
    font-size: 14px;
  }

  .waitlist {
    font-size: 12px;
    font-weight: var(--weight-semibold);
    color: var(--warning-600);
    background: var(--warning-100);
    border-radius: var(--radius-pill);
    padding: 4px 10px;
  }

  .avail-badge {
    font-size: 12px;
    font-weight: var(--weight-semibold);
    color: var(--success-600);
    background: var(--success-100);
    border-radius: var(--radius-pill);
    padding: 4px 10px;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .chev {
    color: var(--navy-300);
    display: inline-flex;
    transition: transform var(--dur-fast) ease, color var(--dur-fast) ease;
  }

  .note {
    font-size: 14px;
    color: var(--text-muted);
    margin: 18px 4px 0;
  }

  .empty {
    font-size: 16px;
    color: var(--text-muted);
    background: var(--white);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 40px;
    text-align: center;
  }

  /* Detail modal */
  .plan-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(11, 44, 64, 0.62);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    opacity: 0;
    transition: opacity 250ms ease;
  }

  .plan-modal.is-open {
    opacity: 1;
  }

  .plan-modal[hidden] {
    display: none;
  }

  .modal-card {
    position: relative;
    background: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-raised);
    max-width: 960px;
    width: 100%;
    max-height: calc(100vh - 48px);
    overflow: auto;
    transform: translateY(16px);
    transition: transform 250ms var(--ease-standard);
  }

  .plan-modal.is-open .modal-card {
    transform: none;
  }

  .modal-close {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 1;
    background: var(--cream-50);
    border: 1px solid var(--border-subtle);
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--navy-800);
    box-shadow: var(--shadow-card);
  }

  .modal-close:hover {
    background: var(--white);
  }

  .modal-cols {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
  }

  .modal-cols.no-photos {
    grid-template-columns: 1fr;
    max-width: 560px;
  }

  .gallery {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--navy-50);
  }

  .main-photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    border-radius: var(--radius-lg) 0 0 0;
  }

  .thumbs {
    display: flex;
    gap: 6px;
    padding: 10px;
    overflow-x: auto;
  }

  .thumb-btn {
    flex: 0 0 72px;
    height: 52px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: var(--radius-sm);
    overflow: hidden;
    cursor: pointer;
    background: none;
    opacity: 0.75;
    transition: opacity var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }

  .thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .thumb-btn:hover {
    opacity: 1;
  }

  .thumb-btn.is-current {
    opacity: 1;
    border-color: var(--navy-500);
  }

  .details {
    padding: 40px 44px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .details h3 {
    font-family: var(--font-display);
    font-size: 36px;
    color: var(--navy-900);
    margin: 0;
  }

  .spec-line {
    font-size: 16px;
    color: var(--charcoal-700);
  }

  .modal-price {
    font-weight: var(--weight-bold);
    color: var(--navy-700);
    font-size: 24px;
  }

  .avail {
    font-size: 13px;
    font-weight: var(--weight-semibold);
    color: var(--success-600);
    background: var(--success-100);
    border-radius: var(--radius-pill);
    padding: 6px 14px;
  }

  .avail.waitlisted {
    color: var(--warning-600);
    background: var(--warning-100);
  }

  .desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--charcoal-700);
    margin: 4px 0 0;
  }

  .features {
    list-style: none;
    padding: 0;
    margin: 4px 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 20px;
    width: 100%;
  }

  .features li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--charcoal-700);
  }

  .features li :global(svg) {
    color: var(--success-600);
    flex: none;
  }

  .modal-cta {
    margin-top: 14px;
    align-self: stretch;
  }

  @media (max-width: 920px) {
    .row {
      grid-template-columns: 90px 1fr auto;
    }

    .meta,
    .sqft {
      display: none;
    }

    .modal-cols {
      grid-template-columns: 1fr;
    }

    .main-photo {
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      aspect-ratio: 16 / 10;
    }

    .details {
      padding: 28px;
    }
  }

  @media (max-width: 560px) {
    .row {
      grid-template-columns: 1fr auto;
    }

    .thumb {
      display: none;
    }

    .chev {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-plan-filters]").forEach((filters) => {
    const table = filters.closest("section")?.querySelector<HTMLElement>("[data-plan-table]");
    if (!table) return;
    filters.querySelectorAll<HTMLButtonElement>(".chip").forEach((chip) => {
      chip.addEventListener("click", () => {
        filters.querySelectorAll(".chip").forEach((c) => c.classList.remove("is-selected"));
        chip.classList.add("is-selected");
        const beds = chip.dataset.beds;
        table.querySelectorAll<HTMLElement>(".row").forEach((row) => {
          const show = beds === "all" || row.dataset.beds === beds;
          if (show) row.removeAttribute("hidden");
          else row.setAttribute("hidden", "");
        });
      });
    });
  });

  // Floor plan detail modals
  document.querySelectorAll<HTMLElement>("[data-plan-table]").forEach((table) => {
    const section = table.closest("section");
    if (!section) return;

    const closeModal = (modal: HTMLElement) => {
      modal.classList.remove("is-open");
      document.body.style.overflow = "";
      setTimeout(() => modal.setAttribute("hidden", ""), 250);
    };

    const openModal = (slug: string) => {
      const modal = section.querySelector<HTMLElement>(`[data-plan-modal="${slug}"]`);
      if (!modal) return;
      modal.removeAttribute("hidden");
      requestAnimationFrame(() => modal.classList.add("is-open"));
      document.body.style.overflow = "hidden";
      (window as any).lucide?.createIcons();
      modal.querySelector<HTMLButtonElement>("[data-modal-close]")?.focus();
    };

    table.querySelectorAll<HTMLElement>(".row[data-plan]").forEach((row) => {
      row.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest("a")) return; // Tour button navigates
        openModal(row.dataset.plan!);
      });
      row.addEventListener("keydown", (e) => {
        if ((e.key === "Enter" || e.key === " ") && !(e.target as HTMLElement).closest("a")) {
          e.preventDefault();
          openModal(row.dataset.plan!);
        }
      });
    });

    section.querySelectorAll<HTMLElement>("[data-plan-modal]").forEach((modal) => {
      modal.querySelectorAll("[data-modal-close]").forEach((btn) => {
        btn.addEventListener("click", () => closeModal(modal));
      });
      modal.addEventListener("click", (e) => {
        if (e.target === modal) closeModal(modal);
      });
      // Photo gallery: thumbnails swap the main image
      const main = modal.querySelector<HTMLImageElement>("[data-main-photo]");
      modal.querySelectorAll<HTMLButtonElement>(".thumb-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          if (!main || !btn.dataset.photo) return;
          main.src = btn.dataset.photo;
          modal.querySelectorAll(".thumb-btn").forEach((b) => b.classList.remove("is-current"));
          btn.classList.add("is-current");
        });
      });
    });

    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      section
        .querySelectorAll<HTMLElement>("[data-plan-modal]:not([hidden])")
        .forEach((m) => closeModal(m));
    });
  });
</script>
