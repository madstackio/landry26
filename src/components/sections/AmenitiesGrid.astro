---
import type { Section } from "../../lib/cms";

interface Props {
  section: Section;
}

const { data } = Astro.props.section;
const amenities: { icon?: string; title: string; description?: string }[] = Array.isArray(
  data.amenities
)
  ? data.amenities
  : [];
---

<section class="amenities">
  <div class="container">
    {
      data.heading && (
        <div class="head">
          <div class="eyebrow">Life at The Landry</div>
          <h2 set:html={data.heading} />
        </div>
      )
    }
    <div class="list">
      {
        amenities.map((a, i) => (
          <div class="row">
            <div class="num">{String(i + 1).padStart(2, "0")}</div>
            <div>
              <div class="title">{a.title}</div>
              {a.description && <div class="desc">{a.description}</div>}
            </div>
            <div class="icon">{a.icon && <i data-lucide={a.icon} style="width:24px;height:24px" />}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .amenities {
    padding: 112px 0;
  }

  .head {
    max-width: 560px;
    margin-bottom: 40px;
  }

  h2 {
    font-size: 44px;
    margin: 16px 0 0;
    text-wrap: pretty;
  }

  .row {
    display: grid;
    grid-template-columns: 56px 1fr 40px;
    gap: 20px;
    align-items: center;
    padding: 26px 8px;
    border-top: 1px solid var(--border-subtle);
    transition: background var(--dur-fast) ease;
  }

  .row:first-child {
    border-top-color: var(--border-strong);
  }

  .row:last-child {
    border-bottom: 1px solid var(--border-strong);
  }

  .row:hover {
    background: var(--white);
  }

  .num {
    font-family: var(--font-display);
    font-size: 19px;
    color: var(--slate-400);
  }

  .title {
    font-family: var(--font-display);
    font-size: 25px;
    color: var(--navy-900);
  }

  .desc {
    font-size: 15px;
    color: var(--text-muted);
    margin-top: 4px;
  }

  .icon {
    color: var(--navy-300);
  }
</style>
