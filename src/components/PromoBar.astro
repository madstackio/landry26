---
import type { Special } from "../lib/cms";

interface Props {
  specials: Special[];
}

// The API only returns specials inside their date window; show the first.
const special = Astro.props.specials[0] ?? null;
---

{
  special && (
    <div class="promo" data-lucid-promo>
      {special.display_mode === "image" && special.image ? (
        <a href="#schedule-a-tour" class="promo-image-link">
          <img src={special.image.url} alt={special.image.alt || special.title} />
        </a>
      ) : (
        <p class="promo-text">
          {special.display_mode === "image_text" && special.image && (
            <img
              class="promo-thumb"
              src={special.image.url}
              alt={special.image.alt || special.title}
            />
          )}
          <strong>{special.title}</strong>
          {special.description && <span> — {special.description}</span>}
          <a href="#schedule-a-tour" class="promo-cta">Book a tour</a>
          {special.disclaimer && <span class="disclaimer">{special.disclaimer}</span>}
        </p>
      )}
    </div>
  )
}

<style>
  .promo {
    background: var(--navy-900);
    color: var(--navy-100);
    font-size: 14px;
    text-align: center;
    padding: 9px 24px;
    letter-spacing: 0.02em;
  }

  .promo-text {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .promo-text strong {
    color: var(--cream-50);
    font-weight: var(--weight-semibold);
  }

  .promo-thumb {
    height: 28px;
    border-radius: var(--radius-sm);
  }

  .promo-cta {
    color: var(--cream-50);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .disclaimer {
    font-size: 11px;
    color: var(--navy-300);
    flex-basis: 100%;
  }

  .promo-image-link {
    display: block;
    line-height: 0;
  }

  .promo-image-link img {
    max-height: 90px;
    margin: 0 auto;
  }
</style>
