---
import type { Globals, PageSummary } from "../lib/cms";
import type { Anchor } from "../lib/anchors";

interface Props {
  globals: Globals;
  pages: PageSummary[];
  locale?: string | null;
  anchors?: Anchor[];
  /** Overlay the hero with a transparent header (pages whose first section is a hero). */
  transparent?: boolean;
}

const { globals, pages, locale = null, anchors = [], transparent = false } = Astro.props;
const prefix = locale ? `/${locale}` : "";
const homeHref = prefix || "/";
const logo = globals.logo_url || "/assets/logo.svg";
const siteName = globals.name || "The Landry";
const phone = globals.contact?.phone ?? null;
const phoneHref = phone ? `tel:${phone.replace(/[^\d+]/g, "")}` : null;
const portalUrl = globals.portal_url ?? null;

const sorted = [...pages].sort((a, b) => a.order_index - b.order_index);
const multiPage = sorted.length > 1;
// Anchor links are prefixed with the home path so they also work from
// standalone routes like /virtual-tours.
const navLinks = multiPage
  ? sorted.map((p, i) => ({ href: i === 0 ? homeHref : `${prefix}/${p.slug}`, label: p.title }))
  : anchors.map((a) => ({ href: `${prefix}/#${a.id}`, label: a.label }));
navLinks.push({ href: `${prefix}/virtual-tours`, label: "Virtual Tours" });

const tourPage = sorted.find((p) => /tour|contact|schedule/i.test(p.slug));
const tourHref = tourPage && multiPage ? `${prefix}/${tourPage.slug}` : `${prefix}/#schedule-a-tour`;
---

<header class="site-header" class:list={{ overlay: transparent }} data-site-header>
  <div class="bar container">
    <a href={homeHref} class="logo-link">
      <img src={logo} alt={siteName} class="logo" />
    </a>
    <nav class="nav" aria-label="Main">
      {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="actions">
      {phone && <a href={phoneHref} class="phone">{phone}</a>}
      {portalUrl && <a href={portalUrl} class="btn btn--secondary portal">Resident Portal</a>}
      <a href={tourHref} class="btn">Schedule a Tour</a>
      <button class="menu-toggle" aria-label="Menu" aria-expanded="false">
        <i data-lucide="menu" style="width:24px;height:24px"></i>
      </button>
    </div>
  </div>
  <nav class="mobile-nav" aria-label="Main mobile" hidden>
    {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    {portalUrl && <a href={portalUrl}>Resident Portal</a>}
    {phone && <a href={phoneHref}>{phone}</a>}
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--cream-50);
    border-bottom: 1px solid var(--border-subtle);
    transition: background 250ms ease, border-color 250ms ease;
  }

  /* Transparent over the hero, solid once scrolled (or with the menu open) */
  .site-header.overlay {
    position: fixed;
    left: 0;
    right: 0;
    background: transparent;
    border-bottom-color: transparent;
  }

  /* Legibility gradient behind the floating header, fades once solid */
  .site-header.overlay::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 150px;
    background: linear-gradient(180deg, rgba(11, 44, 64, 0.6) 0%, rgba(11, 44, 64, 0) 100%);
    pointer-events: none;
    z-index: -1;
    opacity: 1;
    transition: opacity 250ms ease;
  }

  .site-header.overlay.is-solid::before {
    opacity: 0;
  }

  .site-header.overlay.is-solid {
    background: var(--cream-50);
    border-bottom-color: var(--border-subtle);
  }

  .bar {
    height: 78px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .logo {
    height: 54px;
    display: block;
    transition: filter 250ms ease;
  }

  /* Recolor the logo to cream while the header floats over the hero photo */
  .site-header.overlay:not(.is-solid) .logo {
    filter: brightness(0) invert(0.96);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 34px;
  }

  .nav a,
  .phone {
    font-size: 15px;
    font-weight: var(--weight-semibold);
    color: var(--navy-800);
    transition: color 250ms ease;
  }

  .phone {
    color: var(--navy-700);
  }

  .nav a:hover {
    color: var(--navy-500);
  }

  .site-header.overlay:not(.is-solid) .nav a,
  .site-header.overlay:not(.is-solid) .phone,
  .site-header.overlay:not(.is-solid) .menu-toggle {
    color: var(--cream-50);
  }

  .site-header.overlay:not(.is-solid) .nav a:hover {
    color: var(--navy-150);
  }

  .site-header.overlay:not(.is-solid) :global(.btn) {
    background: var(--cream-50);
    border-color: var(--cream-50);
    color: var(--navy-800);
  }

  .site-header.overlay:not(.is-solid) :global(.btn:hover) {
    background: var(--white);
    border-color: var(--white);
  }

  .site-header.overlay:not(.is-solid) :global(.btn--secondary) {
    background: transparent;
    border-color: rgba(250, 248, 245, 0.55);
    color: var(--cream-50);
  }

  .site-header.overlay:not(.is-solid) :global(.btn--secondary:hover) {
    background: rgba(250, 248, 245, 0.12);
    border-color: var(--cream-50);
    color: var(--cream-50);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--navy-800);
    cursor: pointer;
    padding: 6px;
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding: 12px 32px 20px;
    border-top: 1px solid var(--border-subtle);
    background: var(--cream-50);
  }

  .mobile-nav a {
    font-size: 16px;
    font-weight: var(--weight-semibold);
    color: var(--navy-800);
    padding: 10px 0;
  }

  @media (max-width: 1180px) {
    .portal {
      display: none;
    }
  }

  @media (max-width: 920px) {
    .nav {
      display: none;
    }

    .phone {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .mobile-nav:not([hidden]) {
      display: flex;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const toggle = header?.querySelector<HTMLButtonElement>(".menu-toggle");
  const mobileNav = header?.querySelector<HTMLElement>(".mobile-nav");

  let menuOpen = false;
  const syncSolid = () => {
    if (!header?.classList.contains("overlay")) return;
    header.classList.toggle("is-solid", menuOpen || window.scrollY > 24);
  };
  syncSolid();
  window.addEventListener("scroll", syncSolid, { passive: true });

  toggle?.addEventListener("click", () => {
    if (!mobileNav) return;
    menuOpen = mobileNav.hasAttribute("hidden");
    if (menuOpen) {
      mobileNav.removeAttribute("hidden");
      toggle.setAttribute("aria-expanded", "true");
    } else {
      mobileNav.setAttribute("hidden", "");
      toggle.setAttribute("aria-expanded", "false");
    }
    syncSolid();
  });
  mobileNav?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).tagName === "A") {
      mobileNav.setAttribute("hidden", "");
      toggle?.setAttribute("aria-expanded", "false");
      menuOpen = false;
      syncSolid();
    }
  });
</script>
