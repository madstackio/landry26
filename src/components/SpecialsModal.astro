---
import type { Special } from "../lib/cms";

interface Props {
  specials: Special[];
}

// Specials come from LucidOS (/specials) and are already filtered to their
// date window — the first active one is presented as a dismissible modal,
// shown once per browser session.
const special = Astro.props.specials[0] ?? null;
const sessionKey = special ? `landry-special-${special.title}` : "";
---

{
  special && (
    <div
      class="special-overlay"
      data-special-modal
      data-session-key={sessionKey}
      role="dialog"
      aria-modal="true"
      aria-label={special.title}
      hidden
    >
      <div class="card" class:list={{ "image-only": special.display_mode === "image" }}>
        <button class="close" data-special-close aria-label="Close">
          <i data-lucide="x" style="width:20px;height:20px" />
        </button>
        {special.display_mode === "image" && special.image ? (
          <a href="#schedule-a-tour" data-special-cta class="image-link">
            <img src={special.image.url} alt={special.image.alt || special.title} />
          </a>
        ) : (
          <>
            {special.display_mode === "image_text" && special.image && (
              <img
                class="banner"
                src={special.image.url}
                alt={special.image.alt || special.title}
              />
            )}
            <div class="body">
              <div class="eyebrow">Limited-Time Special</div>
              <h3>{special.title}</h3>
              {special.description && <p>{special.description}</p>}
              {special.floor_plan && <span class="tag">{special.floor_plan.name}</span>}
              <a href="#schedule-a-tour" data-special-cta class="btn btn--lg cta">
                Book a Tour
              </a>
              {special.disclaimer && <p class="disclaimer">{special.disclaimer}</p>}
            </div>
          </>
        )}
      </div>
    </div>
  )
}

<style>
  .special-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(11, 44, 64, 0.62);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    opacity: 0;
    transition: opacity 250ms ease;
  }

  .special-overlay.is-open {
    opacity: 1;
  }

  .special-overlay[hidden] {
    display: none;
  }

  .card {
    position: relative;
    background: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-raised);
    max-width: 480px;
    width: 100%;
    max-height: calc(100vh - 48px);
    overflow: auto;
    transform: translateY(16px);
    transition: transform 250ms var(--ease-standard);
  }

  .special-overlay.is-open .card {
    transform: none;
  }

  .card.image-only {
    background: transparent;
    box-shadow: none;
    max-width: 560px;
    overflow: visible;
  }

  .close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 1;
    background: var(--cream-50);
    border: 1px solid var(--border-subtle);
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--navy-800);
    box-shadow: var(--shadow-card);
  }

  .close:hover {
    background: var(--white);
  }

  .image-link {
    display: block;
    line-height: 0;
  }

  .image-link img {
    width: 100%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-raised);
  }

  .banner {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    display: block;
  }

  .body {
    padding: 32px 36px 36px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  h3 {
    font-family: var(--font-display);
    font-size: 30px;
    color: var(--navy-900);
    margin: 0;
    text-wrap: pretty;
  }

  .body p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--charcoal-700);
    margin: 0;
  }

  .tag {
    font-size: 12px;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    color: var(--navy-700);
    background: var(--navy-50);
    border-radius: var(--radius-pill);
    padding: 5px 12px;
  }

  .cta {
    margin-top: 8px;
    align-self: stretch;
  }

  .disclaimer {
    font-size: 12px;
    color: var(--text-muted);
  }
</style>

<script>
  const modal = document.querySelector<HTMLElement>("[data-special-modal]");
  if (modal) {
    const key = modal.dataset.sessionKey || "landry-special";
    const close = () => {
      modal.classList.remove("is-open");
      sessionStorage.setItem(key, "1");
      setTimeout(() => modal.setAttribute("hidden", ""), 250);
    };
    if (!sessionStorage.getItem(key)) {
      setTimeout(() => {
        modal.removeAttribute("hidden");
        requestAnimationFrame(() => modal.classList.add("is-open"));
        modal.querySelector<HTMLButtonElement>("[data-special-close]")?.focus();
        (window as any).lucide?.createIcons();
      }, 1200);
    }
    modal.querySelector("[data-special-close]")?.addEventListener("click", close);
    modal.querySelectorAll("[data-special-cta]").forEach((cta) => {
      cta.addEventListener("click", close);
    });
    modal.addEventListener("click", (e) => {
      if (e.target === modal) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal.hasAttribute("hidden")) close();
    });
  }
</script>
